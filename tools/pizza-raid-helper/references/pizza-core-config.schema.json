{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pizza Core weekly rollover configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "seriesId", "guildId", "forum", "managementBotUserId", "raidHelperBotUserId", "coreRole", "tags", "event", "nativeCalendar", "rollover", "credentials", "statePath", "bootstrap", "activation"],
  "properties": {
    "unsignedAudiencePolicy": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "fresh-dashboard" } } },
        { "type": "object", "additionalProperties": false,
          "required": ["mode", "approvedBy", "approvedAt", "guildId", "coreRoleId", "acceptsUnmonitoredRoleChanges"],
          "properties": {
            "mode": { "const": "standing-core-only" }, "approvedBy": { "const": "Neil Mitchell" },
            "approvedAt": { "type": "string", "format": "date-time" },
            "guildId": { "$ref": "#/$defs/id" }, "coreRoleId": { "$ref": "#/$defs/id" },
            "acceptsUnmonitoredRoleChanges": { "const": true }
          }
        }
      ]
    },
    "version": { "const": 1 },
    "seriesId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "guildId": { "$ref": "#/$defs/id" },
    "forum": { "$ref": "#/$defs/binding" },
    "managementBotUserId": { "$ref": "#/$defs/id" },
    "raidHelperBotUserId": { "$ref": "#/$defs/id" },
    "coreRole": { "$ref": "#/$defs/binding" },
    "tags": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/binding" } },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "templateId", "leaderId", "leaderDisplayName", "description", "timeZone", "weekday", "time", "durationMinutes", "roles"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "templateId": { "type": "string", "minLength": 1 },
        "leaderId": { "$ref": "#/$defs/id" },
        "leaderDisplayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "timeZone": { "const": "America/New_York" },
        "weekday": { "const": 5 },
        "time": { "const": "22:00" },
        "durationMinutes": { "const": 240 },
        "roles": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "cName", "limit", "emoteId"],
            "properties": {
              "name": { "enum": ["Tanks", "Melee", "Ranged", "Healers"] },
              "cName": { "type": "string", "minLength": 1 },
              "limit": { "type": "integer", "minimum": 1, "maximum": 10 },
              "emoteId": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "nativeCalendar": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "voiceChannel", "startGraceMinutes"],
      "properties": {
        "enabled": { "const": true },
        "voiceChannel": { "$ref": "#/$defs/binding" },
        "startGraceMinutes": { "const": 30 }
      }
    },
    "rollover": {
      "type": "object", "additionalProperties": false,
      "required": ["timeZone", "weekday", "time", "maxLateMinutes"],
      "properties": {
        "timeZone": { "const": "America/Halifax" },
        "weekday": { "const": 6 },
        "time": { "const": "03:00" },
        "maxLateMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    },
    "credentials": {
      "type": "object", "additionalProperties": false,
      "required": ["raidHelperApiKeyEnv", "discordTokenEnv"],
      "properties": {
        "raidHelperApiKeyEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "discordTokenEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
      }
    },
    "statePath": { "type": "string", "minLength": 1 },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "eventId", "legacyPolicy"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "eventId": { "$ref": "#/$defs/id" },
        "legacyPolicy": { "type": "boolean" }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["configHash", "rolePolicyCanaryEventId", "lifecycleCanaryThreadId", "nativeCalendarCanaryEventId", "coreSignupVerified", "nonCoreBenchVerified", "lifecycleVerified", "nativeCalendarVerified", "nativeCalendarRetryVerified", "nativeCalendarLifecycleVerified", "verifiedAt"],
      "properties": {
        "configHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "rolePolicyCanaryEventId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "lifecycleCanaryThreadId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "nativeCalendarCanaryEventId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "coreSignupVerified": { "type": "boolean" },
        "nonCoreBenchVerified": { "type": "boolean" },
        "lifecycleVerified": { "type": "boolean" },
        "nativeCalendarVerified": { "type": "boolean" },
        "nativeCalendarRetryVerified": { "type": "boolean" },
        "nativeCalendarLifecycleVerified": { "type": "boolean" },
        "verifiedAt": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9]{16,22}$" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 } }
    }
  }
}
