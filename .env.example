# Discord application credentials. Create these at https://discord.com/developers/applications.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: registers the command only in this Discord server for immediate updates.
# Leave blank to register globally (Discord may take up to an hour to propagate it).
DISCORD_GUILD_ID=

# Optional: lets plain /ready discover the current Pizza Core event automatically.
# Supports a legacy text channel or the parent Discord forum containing Raid-Helper posts.
RAID_HELPER_CHANNEL_ID=

# Optional: server API key from Raid-Helper /apikey, used only by the weekly publisher.
# Keep the actual value in the private .env; never in the skill profile or Git.
RAID_HELPER_API_KEY=

# Optional: makes this Discord role the live Pizza Core source of truth.
# Enable Server Members Intent for the bot in Discord's Developer Portal.
PIZZA_CORE_ROLE_ID=

# Warmane lookup defaults.
WARMANE_DEFAULT_REALM=Lordaeron
HEADLESS=true

# Optional: a browser cookie can improve reliability if Warmane presents a Cloudflare challenge.
# WARMANE_COOKIE=__cf_bm=...

# Needed only on hosts that expect an HTTP health endpoint.
PORT=3000

# Optional music playback. Absolute paths work reliably under Windows Task Scheduler.
# Run scripts/install-music-tools.ps1 for the pinned yt-dlp executable and path output.
# Keep disabled until both executables are installed; music failure does not stop armory.
MUSIC_ENABLED=false
MUSIC_YTDLP_PATH=
MUSIC_FFMPEG_PATH=
